# Copier ce fichier en .env.local et renseigner les valeurs
# Supabase : Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé secrète (Project Settings > API > service_role). Ne jamais l'exposer au navigateur.
# Sert uniquement au lien d'abonnement au calendrier (/agenda/...) : sans elle, ce lien
# n'est pas proposé, mais le téléchargement ponctuel du calendrier continue de fonctionner.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pour signer les liens d'abonnement au calendrier — une phrase aléatoire, à générer
# une seule fois (ex. openssl rand -hex 32). Sans elle, le lien d'abonnement n'est pas proposé.
CALENDAR_TOKEN_SECRET=

# Création de compte : /inscription lui-même reste fermé ; seule cette adresse secrète y mène
# (ex. rejoindre-ministry-school -> /rejoindre-ministry-school), envoyée après le paiement.
# Sans valeur, personne ne peut créer de compte.
INSCRIPTION_CHEMIN=

# Adresse publique du site, pour l'aperçu partagé (Open Graph). Par défaut : https://www.ministryschool.fr
NEXT_PUBLIC_SITE_URL=

# Billetterie BilletWeb : adresse visée par « Prendre ma place » sur la landing.
# Laissée vide, le bouton est désactivé avec une infobulle.
NEXT_PUBLIC_BILLETWEB_URL=

# Police de titre Etna (Adobe Fonts) — optionnel.
# Adresse du projet Web : https://use.typekit.net/XXXXXXX.css
# Sans elle, les titres s'affichent dans une serif de secours.
NEXT_PUBLIC_ADOBE_FONTS_URL=
