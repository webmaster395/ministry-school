# Copier ce fichier en .env.local et renseigner les valeurs
# Supabase : Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Billetterie BilletWeb : adresse visée par « Prendre ma place » sur la landing.
# Laissée vide, le bouton est désactivé avec une infobulle.
NEXT_PUBLIC_BILLETWEB_URL=

# Police de titre Etna (Adobe Fonts) — optionnel.
# Adresse du projet Web : https://use.typekit.net/XXXXXXX.css
# Sans elle, les titres s'affichent dans une serif de secours.
NEXT_PUBLIC_ADOBE_FONTS_URL=
